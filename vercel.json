{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/webhooks/stripe",        "destination": "/api/webhooks?type=stripe" },
    { "source": "/api/webhooks/email-inbound", "destination": "/api/webhooks?type=email-inbound" },
    { "source": "/selbstcheck", "destination": "/selbstcheck.html" },
    { "source": "/bericht",     "destination": "/bericht.html"     },
    { "source": "/coldcall",    "destination": "/coldcall.html"    },
    { "source": "/handwerk",    "destination": "/handwerk.html"    },
    { "source": "/beauty",      "destination": "/beauty.html"      },
    { "source": "/makler",     "destination": "/makler.html"      },
    { "source": "/kanzlei",   "destination": "/kanzlei.html"    },
    { "source": "/coaches",   "destination": "/coaches.html"    },
    { "source": "/kreditvermittler", "destination": "/kreditvermittler.html" },
    { "source": "/handwerker",       "destination": "/handwerker.html"      },
    { "source": "/bot",        "destination": "/bot.html"        },
    { "source": "/makler-bot", "destination": "/makler-bot.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.html|selbstcheck|bericht|coldcall|termin|datenschutz|impressum|bot|makler-bot)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "https://yad.rocks" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "crons": []
}
